# Required for the MySQL service. Replace these local development passwords.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=systemdb
MYSQL_USER=systemuser
MYSQL_PASSWORD=change-this-database-password

# Select: auto, openai, gemini, or local. Auto uses the first configured key.
AI_PROVIDER=auto

# Configure only the provider you selected. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
